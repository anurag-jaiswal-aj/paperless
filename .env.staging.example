# ==============================================================================
# Paperless Staging Environment Configuration Template (.env.staging.example)
#
# INSTRUCTIONS:
# 1. Copy this file to .env.staging:
#      cp .env.staging.example .env.staging
# 2. Generate secure random values for JWT secrets locally:
#      openssl rand -hex 32
# 3. Start a Cloudflare Quick Tunnel on loopback port 8080:
#      cloudflared tunnel --url http://localhost:8080
# 4. Copy the assigned tunnel URL (e.g. https://example.trycloudflare.com) into
#    FRONTEND_URL and TRUSTED_ORIGINS below.
# ==============================================================================

# Loopback host port where Nginx is published for cloudflared (defaults to 8080)
STAGING_PORT=8080

# Environment Lifecycle
NODE_ENV=production
PORT=5000

# Authentication & Session Security (Replace placeholders with random 64-char hex strings)
# Generate each with: openssl rand -hex 32
JWT_SECRET=replace_with_secure_random_64_char_hex_secret
JWT_REFRESH_SECRET=replace_with_secure_random_64_char_hex_refresh_secret
COOKIE_SAMESITE=lax

# Database Configuration (Internal Docker Compose network connection)
MONGO_URI=mongodb://mongo:27017/paperless_staging

# Request Origin Validation & CORS
# Set these to the active Cloudflare Tunnel URL or staging domain
# Example: https://random-subdomain.trycloudflare.com
FRONTEND_URL=https://your-staging-subdomain.trycloudflare.com
TRUSTED_ORIGINS=https://your-staging-subdomain.trycloudflare.com
TRUST_PROXY=loopback,linklocal,uniquelocal

# S3-Compatible Object Storage (Local Staging MinIO Container)
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=paperless-staging
S3_ACCESS_KEY_ID=staging_minio_admin
S3_SECRET_ACCESS_KEY=staging_minio_password
MAX_FILE_SIZE=5242880

# Optional External Integrations (Keep empty for zero-cost operation)
# When omitted, AI features and email delivery are safely disabled or logged to console.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
RESEND_API_KEY=
EMAIL_FROM=noreply@example.com

# Frontend Build Arguments (Keep empty for same-origin relative proxying)
# Leaving these empty ensures the frontend communicates via relative '' paths.
# The frontend image does not need to be rebuilt when the tunnel URL changes.
VITE_API_URL=
VITE_BACKEND_URL=
