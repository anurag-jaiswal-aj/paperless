# ==============================================================================
# Paperless Production Environment Configuration Template (.env.example)
#
# INSTRUCTIONS:
# 1. Copy this file to .env:
#      cp .env.example .env
# 2. Generate secure random 64-character hex strings for JWT secrets:
#      openssl rand -hex 32
# 3. Configure FRONTEND_URL and TRUSTED_ORIGINS with your public domain (HTTPS).
# 4. By default, the frontend port binds to loopback (127.0.0.1:8080) for use
#    behind a reverse proxy (Nginx/Caddy) or edge tunnel (Cloudflare Tunnel).
# ==============================================================================

# Ingress & Network Binding (Defaults to loopback 127.0.0.1:8080)
HOST_BIND=127.0.0.1
PORT=8080

# Environment Lifecycle
NODE_ENV=production

# Authentication & Session Security (Replace placeholders with random 64-char hex strings)
JWT_SECRET=replace_with_secure_random_64_char_hex_secret
JWT_REFRESH_SECRET=replace_with_secure_random_64_char_hex_refresh_secret
COOKIE_SAMESITE=lax

# Database Configuration (Internal Docker Compose connection or external MongoDB Atlas URI)
# Default connects to the self-hosted container defined in docker-compose.yml:
MONGO_URI=mongodb://mongo:27017/paperless

# Request Origin Validation & CORS (Must be your public HTTPS production domain)
FRONTEND_URL=https://your-domain.example.com
TRUSTED_ORIGINS=https://your-domain.example.com
TRUST_PROXY=loopback,linklocal,uniquelocal

# S3-Compatible Object Storage
# Defaults to self-hosted MinIO container in docker-compose.yml:
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=paperless
S3_ACCESS_KEY_ID=minio_admin
S3_SECRET_ACCESS_KEY=minio_password
MAX_FILE_SIZE=5242880

# Optional External Integrations (Keep empty for zero-cost operation)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
RESEND_API_KEY=
EMAIL_FROM=noreply@example.com

# Frontend Build Arguments (Keep empty for same-origin relative proxying)
VITE_API_URL=
VITE_BACKEND_URL=
